{
    "name": "collab",
    "displayName": "collab",
    "description": "Realtime collaboration",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.125.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "browser": "./dist/web/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "collab.helloWorld",
                "title": "Hello World"
            },
            {
                "command": "collab.addItem",
                "title": "Add Item"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "collabContainer",
                    "title": "Collab",
                    "icon": "assets/icon.png"
                }
            ]
        },
        "views": {
            "collabContainer": [
                {
                    "type": "webview",
                    "id": "collabView",
                    "name": "Collab",
                    "icon": "assets/icon.png"
                }
            ]
        }
    },
    "scripts": {
        "test": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/suite/index.js",
        "pretest": "npm run compile-web",
        "vscode:prepublish": "npm run package-web",
        "compile-web": "webpack",
        "watch-web": "webpack --watch",
        "package-web": "webpack --mode production --devtool hidden-source-map",
        "lint": "eslint src",
        "run-in-browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. ."
    },
    "devDependencies": {
        "@types/assert": "^1.5.11",
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.2.0",
        "@types/vscode": "^1.125.0",
        "@types/webpack-env": "^1.18.8",
        "@vscode/test-web": "^0.0.81",
        "assert": "^2.1.0",
        "eslint": "^10.5.0",
        "mocha": "^11.7.6",
        "process": "^0.11.10",
        "ts-loader": "^9.6.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.1",
        "webpack": "^5.109.2",
        "webpack-cli": "^7.2.2"
    },
    "overrides": {
        "diff": "^8.0.4",
        "serialize-javascript": "^7.0.6"
    },
    "dependencies": {
        "fs": "^0.0.1-security"
    }
}
